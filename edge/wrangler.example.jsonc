{
  "name": "soberania-labs-atelier-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ENABLE_AI": "false" },
  "assets": {
    "directory": "../.edition-builds/REPLACE_WITH_APPROVED_BUILD",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "ATELIER_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_UNIQUE_POSITIVE_INTEGER",
      "simple": { "limit": 6, "period": 60 }
    }
  ]
}
