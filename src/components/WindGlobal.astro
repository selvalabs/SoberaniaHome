---
---

<div id="wind-global" class="wind-global" aria-hidden="true">
  <!-- Trilhas e correntes visuais de vento -->
  <svg class="wind-streamers" id="wind-streamers" viewBox="0 0 1000 600" preserveAspectRatio="none">
    <defs>
      <linearGradient id="wind-grad-left" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="var(--ink, #1c211a)" stop-opacity="0" />
        <stop offset="25%" stop-color="var(--ink, #1c211a)" stop-opacity="0.18" />
        <stop offset="65%" stop-color="var(--accent, #3f5930)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--ink, #1c211a)" stop-opacity="0" />
      </linearGradient>
      <linearGradient id="wind-grad-right" x1="100%" y1="0%" x2="0%" y2="0%">
        <stop offset="0%" stop-color="var(--ink, #1c211a)" stop-opacity="0" />
        <stop offset="25%" stop-color="var(--ink, #1c211a)" stop-opacity="0.18" />
        <stop offset="65%" stop-color="var(--accent, #3f5930)" stop-opacity="0.4" />
        <stop offset="100%" stop-color="var(--ink, #1c211a)" stop-opacity="0" />
      </linearGradient>
    </defs>
    <path class="wind-gust-line gust-1" id="gust-line-1" d="M -100 280 C 200 230, 500 330, 1100 260" fill="none" stroke="url(#wind-grad-left)" stroke-width="2.5" stroke-linecap="round" />
    <path class="wind-gust-line gust-2" id="gust-line-2" d="M -150 315 C 250 360, 620 250, 1150 340" fill="none" stroke="url(#wind-grad-left)" stroke-width="1.8" stroke-linecap="round" />
    <path class="wind-gust-line gust-3" id="gust-line-3" d="M -80 350 C 300 300, 720 370, 1200 280" fill="none" stroke="url(#wind-grad-left)" stroke-width="1.2" stroke-linecap="round" />
  </svg>

  <span class="leaf-flight" id="leaf-flight">
    <span class="leaf-depth" id="leaf-depth">
      <span class="leaf-glow" id="leaf-glow"></span>
      <span class="wind-leaf leaf-a" id="wind-leaf"></span>
    </span>
  </span>
  <span class="wind-fragment wind-fragment-a leaf-b" id="wind-fragment-a"></span>
  <span class="wind-fragment wind-fragment-b leaf-c" id="wind-fragment-b"></span>
</div>
