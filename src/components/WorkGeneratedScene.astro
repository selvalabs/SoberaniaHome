---
import GeneratedInkArtwork from './GeneratedInkArtwork.astro';
---
<figure class="choices-sketch choices-reference landing-ink-figure narrative-art" data-work-sketch>
  <GeneratedInkArtwork scene="workbench" />
  <figcaption class="scene-narration" aria-label="O gesto e os ganhos da ferramenta">
    <p data-narration-step><span class="choices-ink">Uma ferramenta amplia o gesto.</span></p>
    <p data-narration-step>Quem recebe o tempo poupado?</p>
    <p data-narration-step class="choices-closing"><strong>Automatizar para viver melhor.</strong></p>
  </figcaption>
</figure>
