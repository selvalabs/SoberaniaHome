---
import '../styles/visual-stories.css';
interface Props { kind:'time'|'handover'|'routes'; }
const {kind}=Astro.props;
const content={
 time:{title:'O tempo que a ferramenta abre.',steps:['A rotina','A ferramenta','A partilha'],lines:['Repetir ocupa o dia.','A ferramenta reúne o que se repete.','Quem trabalha precisa participar do ganho.'],end:'Tempo para cuidar. Criar. Viver.'},
 handover:{title:'Abra o sistema. Veja o que fica.',steps:['Por fora','Por dentro','Nas suas mãos'],lines:['Uma tela é só a parte visível.','Código, dados, acesso e memória de como cuidar.','Entregar é compartilhar a capacidade de continuar.'],end:'As chaves também fazem parte da entrega.'},
 routes:{title:'Muda a casa. A história continua.',steps:['Preparar','Conferir','Continuar'],lines:['Escolher um caminho começa por conhecer o sistema.','Levar os dados exige conferir o que chegou.','Outra infraestrutura. A mesma memória de trabalho.'],end:'Portabilidade é um caminho a construir.'}
}[kind];
---
<figure class:list={['visual-story',`story-${kind}`]} data-visual-story={kind} data-story-step="2" aria-label={content.title}>
  <header class="story-mast"><span>Oficina do comum / {kind==='time'?'01':kind==='handover'?'02':'03'}</span><span>Colagem em movimento</span></header>
  <div class="story-theatre">
    {kind==='handover' && <img class="story-bench-art" src="/assets/edition/cooperative-bench-43.webp" alt="Ilustração gerada: mãos sustentam juntas uma bancada com computador, caderno, chaves e uma planta enraizada." width="1536" height="1024" loading="lazy" decoding="async" />}
    <svg viewBox="0 0 960 460" role="img" aria-label={`${content.title} Colagem conceitual com ilustrações geradas.`} class="story-drawing">
      <defs>
        <pattern id={`story-grid-${kind}`} width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".9" fill="currentColor" opacity=".16"/></pattern>
        <pattern id={`story-hatch-${kind}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(30)"><path d="M0 0V7" stroke="currentColor" stroke-width="1" opacity=".25"/></pattern>
      </defs>
      <rect width="960" height="460" fill={`url(#story-grid-${kind})`}/>
      <path class="story-ground" d="M20 415Q150 387 290 415T560 412T940 415"/>
      {kind==='time' && <>
        <path class="story-wire" d="M85 240H420M530 240C650 240 625 140 790 140M530 240C650 240 625 340 790 340"/>
        {Array.from({length:12},(_,i)=><g data-story-ticket={i} transform={`translate(${75+i%3*64} ${90+Math.floor(i/3)*74})`}><image href="/assets/edition/knowledge-notebook-v1.webp" x="-4" y="-5" width="64" height="70"/></g>)}
        <g data-story-gear transform="translate(470 235)"><image href="/assets/edition/story-workshop-43-v2.webp" x="-175" y="-175" width="350" height="350"/></g>
        <g data-story-reveal class="story-commons"><image href="/assets/edition/story-commons-43-v2.webp" x="650" y="85" width="300" height="300"/></g>
        <text x="85" y="65" class="story-label">O TRABALHO SE REPETE</text>
        <text x="470" y="435" class="story-label" text-anchor="middle">A FERRAMENTA</text>
        <text x="800" y="420" class="story-label" text-anchor="middle">CUIDAR · CRIAR · VIVER</text>
      </>}
      {kind==='handover' && <>
        <path class="story-wire" d="M140 185Q480 40 820 185M140 185Q480 395 820 185"/>
        <g data-story-shell transform="translate(480 220)"><image href="/assets/edition/story-computer-43-v2.webp" x="-170" y="-150" width="340" height="280"/></g>
        {[
          ['CÓDIGO','story-computer-43-v2.webp'],
          ['DADOS','story-archive-43-v2.webp'],
          ['CHAVES','story-keys-43-v2.webp'],
          ['MEMÓRIA','knowledge-notebook-v1.webp']
        ].map(([label,asset],i)=><g data-story-layer={i} transform={`translate(${165+i*210} 200)`}><image href={`/assets/edition/${asset}`} x="-90" y="-95" width="180" height="145"/><text class="story-label story-object-label" y="69" text-anchor="middle">{label}</text></g>)}
      </>}
      {kind==='routes' && <>
        <g class="story-houses">
          <image href="/assets/edition/story-house-43-v2.webp" x="35" y="50" width="320" height="320"/>
          <image href="/assets/edition/story-house-43-v2.webp" x="605" y="50" width="320" height="320"/>
          <text class="story-label" x="200" y="420" text-anchor="middle">DE ONDE VIEMOS</text><text class="story-label" x="760" y="420" text-anchor="middle">OUTRA CASA</text>
        </g>
        <path class="story-wire" d="M200 235C340 40 620 420 760 235"/>
        <g class="story-checkpoint"><image href="/assets/edition/knowledge-notebook-v1.webp" x="425" y="270" width="110" height="110"/><text x="480" y="420" text-anchor="middle" class="story-label">CONFERIR A MEMÓRIA</text></g>
        <g data-story-capsule transform="translate(760 235)"><image href="/assets/edition/story-archive-43-v2.webp" x="-75" y="-85" width="150" height="150"/><text y="90" text-anchor="middle" class="story-label story-object-label">SISTEMA + DADOS</text></g>
        {Array.from({length:6},(_,i)=><circle data-story-packet={i} cx={660+i*16} cy="300" r="4" class="story-packet"/>)}
      </>}
    </svg>
  </div>
  <figcaption>
    <ol class="story-captions">{content.lines.map((line,i)=><li data-story-caption={i}><span>0{i+1}</span><p>{line}</p></li>)}</ol>
    <div class="story-controls" role="group" aria-label={`Percorrer: ${content.title}`}>{content.steps.map((step,i)=><button type="button" data-story-go={i} aria-pressed={i===2}><span>0{i+1}</span>{step}</button>)}</div>
    <p class="story-conclusion">{content.end}</p>
  </figcaption>
</figure>
<script>
  import {initVisualStories} from '../scripts/visual-stories';
  initVisualStories();
</script>
