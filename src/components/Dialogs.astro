</dialog>

<dialog id="content-dialog" class="content-dialog" aria-labelledby="dialog-title">
  <header class="dialog-bar">
    <span id="dialog-kicker">Caderno do Laboratório</span>
    <button type="button" data-close-dialog aria-label="Fechar texto">×</button>
  </header>
  <div class="dialog-scroll" id="dialog-scroll">
    <h2 id="dialog-title"></h2>
    <div id="dialog-content"></div>
  </div>
</dialog>
