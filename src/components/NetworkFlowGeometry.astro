---
import {networkWires,cableGeometry,cablePath} from '../scripts/network-flow-model';
interface Props {mode?: 'capture'|'response'}
const {mode='capture'}=Astro.props;
const glowId=`network-${mode}-glow`;
const wires=networkWires.filter(wire=>mode==='response'?wire.kind==='common':wire.kind!=='common');
---
<g class="network-flows" data-network-flow data-network-mode={mode} aria-hidden="true">
  <defs><filter id={glowId} x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="5" /></filter></defs>
  {wires.map(wire=><g data-network-wire={wire.id} data-network-kind={wire.kind}>
    <path class="network-wire-halo" d={cablePath(cableGeometry(wire,1))} filter={`url(#${glowId})`} />
    <path class="network-wire" d={cablePath(cableGeometry(wire,1))} pathLength="1" />
    {Array.from({length:5},()=> <circle class="network-packet" r="4.5" opacity="0" />)}
  </g>)}
  {mode==='response'&&<g class="network-local-light" data-network-local-light>
    <ellipse cx="760" cy="800" rx="54" ry="23"/><ellipse cx="650" cy="240" rx="42" ry="22"/><ellipse cx="1240" cy="220" rx="42" ry="22"/>
  </g>}
</g>
