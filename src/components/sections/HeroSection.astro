---
const generateEyebrow = (text: string, className: string) => {
  const letters = text.split('').map(char => `<span class="eyebrow-glyph">${char}</span>`).join('');
  return `<span class="${className}">
    <span class="eyebrow-readable">${text}</span>
    <span aria-hidden="true">${letters}</span>
  </span>`;
};
---

<section id="hero" class="hero section" data-number="1">
  <div class="hero-stage">
    <div class="tree-wrap" aria-hidden="true">
      <img class="tree" src="/assets/tree.png" alt="" width="915" height="1220" fetchpriority="high" />
      <i class="leaf-origin" id="leaf-origin"></i>
      <span class="rest-leaf leaf-a"></span>
    </div>
    <div class="hero-copy">
      <div class="hero-title-block">
        <div class="hero-overline">
          <span class="hero-identity">
            <Fragment set:html={generateEyebrow('Laboratório independente', 'eyebrow-lab')} />
            <Fragment set:html={generateEyebrow('Sistemas Brasileiros', 'eyebrow-tech')} />
          </span>
        </div>
        <h1>
          <span class="hero-title-tech">Tecnologia</span> 
          <span class="hero-title-service">a serviço</span><br />
          <em class="hero-title-human">da humanidade.</em>
        </h1>
      </div>
      <div class="hero-message">
        <div class="hero-thesis">
          <p class="hero-lead">
            <span class="hero-opening">
              <strong class="hero-lab-name">Soberania Labs</strong> desenvolve ferramentas para melhorar as condições de trabalho e contribuir para uma <em class="hero-ink-note">sociedade mais justa.</em>
            </span>
          </p>
          <p class="hero-argument">
            Sem <strong class="hero-mark">ferramentas e conhecimento</strong>, um povo fica mais vulnerável à exploração. Quando pode compreender, construir e transformar a tecnologia que usa, ganha condições de <span class="hero-future">decidir seu futuro</span> e cultivar prosperidade por gerações.
          </p>
        </div>
        <p class="hero-method">
          Desenvolvemos <strong>software, processos inteligentes e infraestrutura digital</strong> para simplificar processos, reduzir tarefas repetitivas e ampliar a capacidade de quem trabalha. Pesquisamos, experimentamos e construímos com quem conhece os desafios de perto.
        </p>
      </div>
      <div class="text-actions">
        <a href="#trabalho" data-jump>Ver o que fazemos</a>
        <a href="#manifesto" data-jump>Ler o manifesto</a>
      </div>
    </div>
    <div class="hero-bottom">
      <p>Soberania Labs · Florianópolis · Brasil · rede aberta para o mundo</p>
      <a href="#folha" data-jump aria-label="Continuar para Escolhas">↓</a>
    </div>
  </div>
</section>
