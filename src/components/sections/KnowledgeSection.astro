import '../../styles/knowledge-print.css';
---

<section id="deslocamento-2" class="section intelligence-section knowledge-cover" data-number="4" aria-labelledby="knowledge-title">
  <div class="knowledge-cover-stage">
    <div class="section-label"><span>04</span><span>Inteligências</span></div>
    <div class="knowledge-cover-left">
      <h2 id="knowledge-title">Saberes diferentes.<em>Soluções construídas em comum.</em></h2>
      <div class="knowledge-cover-copy">
        <p>Há conhecimento na <em class="knowledge-copy-research">pesquisa</em>, no <span class="knowledge-copy-practice">ofício e na vida cotidiana.</span> Quem trabalha com uma ferramenta, cuida de uma comunidade ou enfrenta um problema todos os dias conhece detalhes que precisam participar do projeto.</p>
        <p>Colocamos esses saberes em conversa com o <span class="knowledge-copy-technical">conhecimento técnico</span> para decidir o que construir, experimentar caminhos e ajustar a solução com <em class="knowledge-copy-experience">quem vai usá-la.</em></p>
        <p class="knowledge-cover-closing"><em>Quem vive o problema participa da construção.</em></p>
      </div>
    </div>
    <figure class="knowledge-collage" aria-label="Mesa de pesquisa em colagem: observação, trabalho manual, natureza e código. Imagens ilustrativas geradas.">
      <img class="knowledge-notebook" src="/assets/edition/knowledge-notebook-v1.webp" alt="Caderno de campo aberto com desenhos botânicos a lápis." decoding="async" loading="lazy" width="1225" height="1284" />
      <img class="knowledge-hands" src="/assets/edition/knowledge-hands-v1.webp" alt="Recorte ilustrativo em preto e branco de mãos encaixando uma estrutura de madeira." decoding="async" loading="lazy" width="1122" height="1402" />
      <img class="knowledge-branch" src="/assets/edition/knowledge-branch-v1.webp" alt="" decoding="async" loading="lazy" width="1024" height="1536" />
      <pre class="knowledge-code" aria-label="Fragmento ilustrativo de código"><code><span># conhecimento em conversa</span>
for registro in observacoes:
    contexto = escutar(registro)
    investigar(contexto)
    compartilhar()</code></pre>
      <figcaption class="knowledge-notes">
        <span class="knowledge-note note-making">Quem faz<br />conhece os detalhes.</span>
        <span class="knowledge-note note-living">Quem vive<br />conhece o contexto.</span>
        <span class="knowledge-note note-research">Quem pesquisa<br />abre possibilidades.</span>
      </figcaption>
    </figure>
  </div>
</section>

