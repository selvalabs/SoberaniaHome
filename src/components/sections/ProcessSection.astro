---
const steps = [{"name": "Entender", "text": "Escutar quem vive a rotina.", "output": "o problema em comum."}, {"name": "Investigar", "text": "Comparar caminhos possíveis.", "output": "hipóteses para conferir."}, {"name": "Prototipar", "text": "Experimentar antes de ampliar.", "output": "um primeiro teste."}, {"name": "Construir", "text": "Dar forma ao caminho.", "output": "software utilizável."}, {"name": "Testar", "text": "Conferir com quem usa.", "output": "evidências para ajustar."}, {"name": "Transferir", "text": "Preparar quem continua.", "output": "acessos e conhecimento."}];
---
<section id="processo" class="section process-section dark concise-process" data-number="6">
  <div class="sequence process-sequence" data-kind="process" data-states="6" data-puzzle-master="true" data-puzzle-board="true">
    <div class="scene-frame">
      <div class="prose-section section-intro process-intro">
        <div class="section-label"><span>06</span><span>O processo</span></div>
        <h2>Tecnologia começa <em>antes do código.</em></h2>
      </div>
      <header class="scene-head"><span>Escutar. Construir. Compartilhar.</span><span class="scene-count">01 / 06</span></header>
      <div class="process-stage">
        <div class="process-periphery" aria-label="Seis peças do processo. Selecione uma peça para conhecer sua etapa.">
          <div class="process-board">
            {steps.map((step,index)=><button type="button" class="process-node" data-process-piece={index} aria-label={`Etapa ${index+1}: ${step.name}`} aria-pressed={index===0?'true':'false'}><span>{String(index+1).padStart(2,'0')}</span><b>{step.name}</b></button>)}
          </div>
          <span class="process-board-note">Cada parte encontra seu lugar.</span>
        </div>
        <div class="process-panels" aria-label="Caderno de campo: as seis etapas">
          {steps.map((step,index)=><article class="process-panel">
            <h3><button type="button" data-process-step={index}><span class="process-step-number">{String(index+1).padStart(2,'0')}</span>{step.name}</button></h3>
            <div class="process-body"><p>{step.text}<br /><span class="process-output">Saída: {step.output}</span></p></div>
          </article>)}
        </div>
      </div>
      <footer class="scene-foot"><span class="scene-hint">Role para montar · <a href="/caderno/antes-do-codigo/">O método no Caderno</a></span><div class="scene-progress" aria-hidden="true"><i></i></div><div class="scene-controls"><button type="button" data-prev aria-label="Etapa anterior">←</button><button type="button" data-next aria-label="Próxima etapa">→</button></div></footer>
    </div>
  </div>
</section>
