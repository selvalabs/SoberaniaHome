---
const nodes = [{"name": "DEMANDAS", "title": "Uma necessidade real.", "text": "É dela que o projeto parte."}, {"name": "CÓDIGO", "title": "Regras que escolhemos.", "text": "Quem pode acessar, decidir e transformar?"}, {"name": "DADOS", "title": "Memória do trabalho.", "text": "Coletar o necessário. Manter o contexto."}, {"name": "ENERGIA", "title": "A internet tem chão.", "text": "Máquinas e energia sustentam cada tarefa."}, {"name": "ÁGUA", "title": "Tecnologia ocupa território.", "text": "Recursos da vida também sustentam sistemas."}, {"name": "TRABALHO", "title": "Capacidade compartilhada.", "text": "As pessoas decidem como automatizar."}, {"name": "TERRITÓRIO", "title": "Cada lugar tem condições.", "text": "A conexão e a rotina importam."}, {"name": "CULTURA", "title": "Criar outros caminhos.", "text": "A cultura também transforma o código."}, {"name": "CONHECIMENTO", "title": "Saber em circulação.", "text": "Aprender. Documentar. Compartilhar."}];
---
<section id="espiral" class="section spiral-section dark concise-spiral" data-number="11">
  <div class="sequence spiral-sequence" data-kind="spiral" data-states="4">
    <div class="scene-frame">
      <div class="prose-section section-intro spiral-intro"><div class="section-label"><span>11</span><span>Conexões</span></div><h2>Nada existe <em>isolado.</em></h2></div>
      <header class="scene-head"><span>Do código à vida, da vida ao código</span><span class="scene-count">01 / 04</span></header>
      <div class="spiral-stage">
        <div class="orbit-view" id="orbit-view" role="group" aria-label="Explore as relações entre tecnologia e sociedade">
          <i class="orbit-ring ring-outer" aria-hidden="true"></i><i class="orbit-ring ring-inner" aria-hidden="true"></i>
          <strong class="orbit-center">VIDA<span>no centro</span></strong>
          {nodes.map((node,index)=><button type="button" class="orbit-word" data-orbit-node={index} data-orbit-title={node.title} data-orbit-text={node.text} aria-pressed={index===0?'true':'false'}>{node.name}</button>)}
        </div>
        <div class="spiral-reading">
          <div class="spiral-captions">
            <article class="spiral-caption"><span class="small-label">01 / Organizar</span><p>Da necessidade ao código.</p></article>
            <article class="spiral-caption"><span class="small-label">02 / Sustentar</span><p>Do código à energia.</p></article>
            <article class="spiral-caption"><span class="small-label">03 / Nutrir</span><p>Da energia ao território.</p></article>
            <article class="spiral-caption"><span class="small-label">04 / Imaginar</span><p>Do território à cultura.</p></article>
          </div>
          <div class="orbit-note" id="orbit-note" aria-live="polite" aria-atomic="true"><h3 id="orbit-note-title">{nodes[0].title}</h3><p id="orbit-note-text">{nodes[0].text}</p></div>
          <p class="orbit-instruction">Toque numa palavra.</p>
        </div>
      </div>
      <footer class="scene-foot"><span class="scene-hint"><a href="/caderno/nada-existe-isolado/">As relações no Caderno</a></span><div class="scene-progress" aria-hidden="true"><i></i></div><div class="scene-controls"><button type="button" data-prev aria-label="Conexão anterior">←</button><button type="button" data-next aria-label="Próxima conexão">→</button></div></footer>
    </div>
  </div>
</section>
