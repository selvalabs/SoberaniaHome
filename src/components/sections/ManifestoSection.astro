---
const principles = [
  ['Dignidade antes da eficiência.','O trabalho tem pessoas dentro.','Antes de automatizar, perguntar quem ganha tempo, quem assume o risco e como a mudança afeta o trabalho. Uma operação mais rápida precisa fazer sentido para quem a sustenta.'],
  ['Autonomia antes da dependência.','Projetar a continuidade.','Escolher ferramentas com caminhos de manutenção, exportação e substituição. A entrega inclui acesso e documentação para que o cliente possa continuar e tomar novas decisões.'],
  ['Supervisão humana antes da autoridade algorítmica.','A decisão tem responsável.','Delimitar o que um agente pode fazer, registrar suas ações e definir onde a aprovação humana é necessária. Uma resposta convincente não dispensa verificação.'],
  ['Conhecimento plural antes da monocultura intelectual.','Escutar também é método.','Colocar pesquisa e técnica em conversa com quem vive o problema. A experiência do território ajuda a revelar requisitos que um formulário ou um modelo pode deixar de fora.'],
  ['Interoperabilidade antes do aprisionamento.','Abrir as conexões.','Documentar formatos, interfaces e integrações. Considerar a troca de uma ferramenta desde o desenho da arquitetura, em vez de descobrir o custo da saída tarde demais.'],
  ['Ecologia como infraestrutura.','O digital também ocupa o mundo.','Considerar recursos computacionais, manutenção e vida útil. Escolher a complexidade necessária ao problema e evitar processamento que não acrescenta valor ao uso.'],
  ['Segurança como parte do projeto.','Cuidar desde o começo.','Trabalhar com permissões proporcionais, revisão de mudanças, proteção de segredos e recuperação. A segurança acompanha o desenho e a operação do sistema.'],
  ['Documentação como transferência de poder.','Deixar um caminho legível.','Registrar como instalar, operar, investigar falhas e recuperar. Explicar as decisões para a próxima pessoa conseguir avaliar e modificar o que recebeu.'],
  ['Cooperação como tecnologia.','Construir capacidade em comum.','Definir acordos claros, compartilhar conhecimento e criar ferramentas que apoiem o trabalho coletivo. A forma de colaborar faz parte da solução.'],
  ['Construção como parte da crítica.','Experimentar. Verificar. Refazer.','Transformar uma hipótese em algo que possa ser usado, observado e contestado. Mostrar os limites do que existe e usar o retorno das pessoas para orientar a próxima versão.']
];
const examples:Record<number,{href:string;label:string}> = {
  1:{href:'#editor',label:'Na entrega: acesso, documentação e continuidade'},
  2:{href:'#possibilidades',label:'Na Mesa: contexto, limites e revisão da proposta'},
  4:{href:'#soberania',label:'Na arquitetura: hospedar, levar dados e conectar'},
  9:{href:'#laboratorio',label:'No laboratório: interfaces em diferentes estágios'}
};
---

<section id="manifesto" class="section manifesto dark manifesto-edition" data-number="12" aria-labelledby="manifesto-title">
  <div class="manifesto-heading">
    <div class="section-label"><span>12</span><span>Manifesto</span></div>
    <h2 id="manifesto-title">O que orienta<br /><em>cada escolha.</em></h2>
    <p>Escolha um princípio. Veja o que ele muda no projeto.</p>
    <div class="manifesto-compass" aria-hidden="true"><span data-manifesto-number>01</span><svg viewBox="0 0 240 240"><circle cx="120" cy="120" r="104"/><circle cx="120" cy="120" r="78"/><path d="M120 0V42M120 198V240M0 120H42M198 120H240M47 47L68 68M172 172L193 193M47 193L68 172M172 68L193 47"/></svg><small>PRINCÍPIO EM FOCO</small></div>
  </div>
  <div class="manifesto-ledger" data-manifesto-ledger>
    {principles.map(([principle,title,body],index)=><details class="manifesto-principle" data-principle-number={String(index+1).padStart(2,'0')}>
      <summary><span class="principle-index">{String(index+1).padStart(2,'0')}</span><span class="principle-statement">{principle}</span><span class="principle-toggle" aria-hidden="true">+</span></summary>
      <div class="principle-consequence"><span>NO PROJETO</span><div><h3>{title}</h3><p>{body}</p>{examples[index] && <a class="principle-example" href={examples[index].href} data-jump>{examples[index].label} ↗</a>}</div></div>
    </details>)}
    <p class="manifesto-signature">Soberania Labs <span>—</span> tecnologia para ampliar autonomia.</p>
  </div>
</section>
