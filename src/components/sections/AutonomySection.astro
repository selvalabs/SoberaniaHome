---
import '../../styles/edition-interactions.css';
import GeneratedInkArtwork from '../GeneratedInkArtwork.astro';
---

<section id="editor" class="section autonomy-section handover-section" data-number="8" aria-labelledby="handover-title">
  <div id="handover-drawing" class="handover-ink-intro narrative-section" data-narrative="handover">
    <div class="handover-narrative-stage narrative-stage">
      <div class="narrative-meta"><div class="section-label"><span>08</span><span>O que fica</span></div><span data-narrative-counter aria-hidden="true">01 / 03</span></div>
      <h2 id="handover-title">A entrega também<br />é <em>autonomia.</em></h2>
      <figure class="narrative-art landing-ink-figure"><GeneratedInkArtwork scene="handover" /><figcaption class="scene-narration"><p data-narration-step>As chaves ficam com quem opera.</p><p data-narration-step>O caminho fica registrado.</p><p data-narration-step>Capacidade de continuar.</p></figcaption></figure>
      <footer class="narrative-footer"><span>Ilustração editorial</span><a href="/caderno/capacidade-de-continuar/">A entrega no Caderno</a></footer>
    </div>
  </div>
  <details class="handover-inspector"><summary>Explorar acesso, documentação e dados</summary>

  <div class="handover-bench" data-edition-tabs data-active="acesso">
    <div class="handover-directory">
      <div class="instrument-label"><i aria-hidden="true"></i> O que acompanha a entrega</div>
      <nav class="handover-tabs" data-edition-tablist aria-label="O que acompanha um sistema">
        <a href="#entrega-acesso" data-edition-tab="acesso"><span>01</span><b>Acesso</b><i aria-hidden="true">↗</i></a>
        <a href="#entrega-conhecimento" data-edition-tab="conhecimento"><span>02</span><b>Conhecimento</b><i aria-hidden="true">↗</i></a>
        <a href="#entrega-liberdade" data-edition-tab="liberdade"><span>03</span><b>Portabilidade</b><i aria-hidden="true">↗</i></a>
      </nav>

    </div>

    <div class="handover-documents">
      <article id="entrega-acesso" class="handover-document" data-edition-panel="acesso">
        <header class="document-mast"><span>SOBERANIA / ENTREGA</span><span>01 — ACESSO</span></header>
        <div class="document-body">
          <span class="document-type">Inventário de autonomia</span>
          <h3>Quem opera precisa<br />ter as chaves.</h3>
          <p>Contas, permissões e responsáveis.</p>
          <ul class="handover-inventory">
            <li><span>Repositório</span><b>Código e histórico</b><i aria-hidden="true">↗</i></li>
            <li><span>Infraestrutura</span><b>Acesso e responsáveis</b><i aria-hidden="true">↗</i></li>
            <li><span>Dados</span><b>Cópia e recuperação</b><i aria-hidden="true">↗</i></li>
            <li><span>Operação</span><b>Permissões claras</b><i aria-hidden="true">↗</i></li>
          </ul>
          <p class="document-annotation">Permissões claras para cuidar.</p>
        </div>
        <footer class="document-footer"><span>Princípio de projeto</span><span>01 / 03</span></footer>
      </article>
      <article id="entrega-conhecimento" class="handover-document" data-edition-panel="conhecimento">
        <header class="document-mast"><span>SOBERANIA / ENTREGA</span><span>02 — CONHECIMENTO</span></header>
        <div class="document-body">
          <span class="document-type">Caderno de operação</span>
          <h3>Documentar é<br />transferir capacidade.</h3>
          <p>Um ponto de partida para a próxima pessoa.</p>
          <div class="document-tree" aria-label="Exemplo de organização da documentação">
            <p><span>projeto /</span></p>
            <p>├── <b>LEIA-ME</b> <em>comece aqui</em></p>
            <p>├── decisões / <em>o porquê</em></p>
            <p>├── operação / <em>como cuidar</em></p>
            <p>└── recuperação / <em>como retomar</em></p>
          </div>
          <p class="document-annotation">Para quem chega amanhã.</p>
        </div>
        <footer class="document-footer"><span>Estrutura ilustrativa</span><span>02 / 03</span></footer>
      </article>
      <article id="entrega-liberdade" class="handover-document" data-edition-panel="liberdade">
        <header class="document-mast"><span>SOBERANIA / ENTREGA</span><span>03 — PORTABILIDADE</span></header>
        <div class="document-body">
          <span class="document-type">Contrato de saída</span>
          <h3>Um caminho de saída<br />é parte da entrada.</h3>
          <p>Formatos conhecidos. Migração conferida.</p>
          <pre class="portable-example" aria-label="Exemplo ilustrativo de dados portáveis"><code><span>{'{'}</span>
  "formato": "aberto",
  "dados": "exportáveis",
  "decisões": "documentadas",
  "próximo_caminho": <b>"você escolhe"</b>
<span>{'}'}</span></code></pre>
          <p class="document-annotation">A saída também se planeja.</p>
        </div>
        <footer class="document-footer"><span>Exemplo conceitual</span><span>03 / 03</span></footer>
      </article>
    </div>
  </div>
  </details>
</section>

<script>
  import { initEditionInteractions } from '../../scripts/edition-interactions';
  initEditionInteractions();
</script>
