---
const routes = [{"key": "hospedar", "label": "Hospedar", "title": "Escolher onde roda.", "path": ["Aplicação", "Configuração", "Infraestrutura escolhida"], "text": "Conhecer. Operar. Recuperar."}, {"key": "migrar", "label": "Levar os dados", "title": "Preservar a memória.", "path": ["Dados", "Exportação conferida", "Novo destino"], "text": "A memória segue com o trabalho."}, {"key": "integrar", "label": "Conectar", "title": "Ampliar as conexões.", "path": ["Ferramenta", "Interface e permissões", "Outros sistemas"], "text": "Construir capacidade em comum."}];
---

<section id="soberania" class="section sovereignty route-section concise-routes" data-number="9" aria-labelledby="route-title">
  <div class="route-heading">
    <div class="section-label"><span>09</span><span>Soberania</span></div>
    <h2 id="route-title">O Brasil precisa construir<br /><em>a tecnologia de que depende.</em></h2>

  </div>
  <div class="sovereign-instrument" data-edition-tabs data-active="hospedar">
    <nav class="route-tabs" data-edition-tablist aria-label="Caminhos de autonomia">
      {routes.map((route,index)=><a href={`#caminho-${route.key}`} data-edition-tab={route.key}><span>0{index+1}</span>{route.label}<i aria-hidden="true">↗</i></a>)}
    </nav>
    <div class="route-diagram" aria-hidden="true">
      <div class="route-coordinate coordinate-top">CAMPO DE POSSIBILIDADES / 03 ROTAS</div>
      <svg class="route-wires" viewBox="0 0 1000 360" preserveAspectRatio="none">
        <defs><pattern id="route-grid" width="25" height="25" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r=".7" fill="currentColor" opacity=".2" /></pattern></defs>
        <rect width="1000" height="360" fill="url(#route-grid)" />
        <path class="route-wire" data-route-line="hospedar" d="M140 180 H345 Q390 180 390 135 V100 Q390 65 435 65 H845" />
        <path class="route-wire" data-route-line="migrar" d="M140 180 H845" />
        <path class="route-wire" data-route-line="integrar" d="M140 180 H345 Q390 180 390 225 V260 Q390 295 435 295 H845" />
        <circle class="route-junction" cx="390" cy="180" r="6" />
      </svg>
      <div class="route-source"><span>O que você<br />construiu</span><i>●</i></div>
      <div class="route-destination destination-host" data-route-node="hospedar"><span>Infraestrutura</span><b>Outra casa</b></div>
      <div class="route-destination destination-data" data-route-node="migrar"><span>Memória</span><b>Dados portáveis</b></div>
      <div class="route-destination destination-connect" data-route-node="integrar"><span>Cooperação</span><b>Novas conexões</b></div>
      <div class="route-coordinate coordinate-bottom">O FUTURO NÃO PRECISA TER UM ÚNICO DESTINO.</div>
    </div>
    <div class="route-readout">
      {routes.map((route,index)=><article id={`caminho-${route.key}`} data-edition-panel={route.key} class="route-panel">
        <div class="route-panel-heading"><span class="instrument-label">Rota 0{index+1}</span><h3>{route.title}</h3></div>
        <div class="route-panel-copy"><ol class="route-path" aria-label="Etapas do caminho">{route.path.map(step=><li>{step}</li>)}</ol><p>{route.text}</p></div>
      </article>)}
    </div>
  </div>
  <p class="route-footnote"><a href="/caderno/construir-no-brasil/">Formar, manter, transformar · Caderno</a></p>
</section>
