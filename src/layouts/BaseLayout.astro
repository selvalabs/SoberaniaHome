---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Soberania Labs — Tecnologia para ampliar autonomia",
  description = "Soberania Labs. Software, processos inteligentes, infraestrutura e pesquisa para ampliar autonomia."
} = Astro.props;

import '../styles/global.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#eee9df" />
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#conteudo">Ir ao conteúdo</a>
  <slot />

  <script>
    import { initMotion } from '../scripts/motion';
    
    // Inicializa o motor completo desenvolvido nativamente com GSAP
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initMotion());
    } else {
      initMotion();
    }
  </script>
</body>
</html>
