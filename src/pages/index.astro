---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import WindGlobal from '../components/WindGlobal.astro';
import Dialogs from '../components/Dialogs.astro';

import HeroSection from '../components/sections/HeroSection.astro';
import ChoicesSection from '../components/sections/ChoicesSection.astro';
import TechnologySection from '../components/sections/TechnologySection.astro';
import KnowledgeSection from '../components/sections/KnowledgeSection.astro';
import WorkSection from '../components/sections/WorkSection.astro';
import ProcessSection from '../components/sections/ProcessSection.astro';
import AutonomySection from '../components/sections/AutonomySection.astro';
import AtelierSection from '../components/sections/AtelierSection.astro';
import LabSection from '../components/sections/LabSection.astro';
import SpiralSection from '../components/sections/SpiralSection.astro';
import SovereigntySection from '../components/sections/SovereigntySection.astro';
import ReferencesSection from '../components/sections/ReferencesSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ManifestoSection from '../components/sections/ManifestoSection.astro';
import JournalSection from '../components/sections/JournalSection.astro';
import ContactFooterSection from '../components/sections/ContactFooterSection.astro';
---

<BaseLayout>
  <Header />
  <WindGlobal />

  <main id="conteudo">
    <HeroSection />
    <ChoicesSection />
    <TechnologySection />
    <KnowledgeSection />
    <WorkSection />
    <ProcessSection />
    <AutonomySection />
    <AtelierSection />
    <LabSection />
    <SpiralSection />
    <SovereigntySection />
    <ReferencesSection />
    <AboutSection />
    <ManifestoSection />
    <JournalSection />
    <ContactFooterSection />
  </main>

  <Dialogs />

  <!-- Scripts de dados, conteúdo e navegação de diálogos -->
  <script is:inline src="/scripts/config.js"></script>
  <script is:inline src="/scripts/content.js?v=hero-copy-2"></script>
  <script is:inline src="/scripts/portfolio.js?v=analytics-21-1"></script>
  <script is:inline src="/scripts/app.js"></script>
  <script is:inline src="/demos/landing-collection/data.js?v=landing-order-3"></script>
  <script is:inline src="/demos/landing-collection/gallery.js?v=landing-clean-11"></script>
  <script is:inline src="/scripts/reference-search.js?v=reference-search-1"></script>
  <script is:inline src="/scripts/monitor-preview.js?v=17-11"></script>
  <script is:inline src="/scripts/circulo-preview.js?v=19-2"></script>
  <script is:inline src="/scripts/analytics-preview.js?v=21-1"></script>

  <script is:inline src="/scripts/app-interface-previews.js?v=app-views-1"></script>
</BaseLayout>
