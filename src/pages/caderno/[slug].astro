---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import {journalArticles,articlePath,principles,examples} from '../../data/journal';
import {canonicalUrl,serializeStructuredData} from '../../lib/seo';
import '../../styles/journal-reading.css';
export function getStaticPaths(){return journalArticles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const url=canonicalUrl(articlePath(article.slug));
---
<BaseLayout title={`${article.title} — Caderno / Soberania Labs`} description={article.deck} interactive={false}>
  <script slot="head" type="application/ld+json" set:html={serializeStructuredData({'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.deck,inLanguage:'pt-BR',author:{'@type':'Organization',name:'Soberania Labs'},...(url?{url,mainEntityOfPage:url}:{})})} />
  <header class="reading-mast"><a href="/" aria-label="Soberania Labs, página inicial">SOBERANIA <b>LABS</b></a><a href="/#caderno">Caderno aberto</a><ThemeToggle /></header>
  <main class="journal-reading" id="conteudo">
    <article>
      <header><p class="reading-category">{article.category}</p><h1>{article.title}</h1><p class="reading-deck">{article.deck}</p><p class="reading-byline">Soberania Labs · Caderno aberto</p></header>
      {article.sections.map(section=><section id={section.id}>{section.heading&&<h2>{section.heading}</h2>}{section.paragraphs.map(p=><p>{p}</p>)}</section>)}
      {article.slug==='manifesto'&&<div class="reading-principles">{principles.map(([principle,title,body],index)=><section id={`principio-${index+1}`}><p class="reading-category">{String(index+1).padStart(2,'0')} / {principle}</p><h2>{title}</h2><p>{body}</p>{examples[index]&&<a href={`/${examples[index].href}`}>{examples[index].label}</a>}</section>)}<p>Soberania Labs — tecnologia para ampliar autonomia.</p></div>}
      {article.sources&&article.sources.length>0&&<aside class="reading-sources" aria-label="Fontes e referências"><h2>Fontes e referências</h2><ul>{article.sources.map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>)}</ul><p>Os textos desta edição são editoriais. Paráfrases são identificadas e não substituem a leitura das fontes.</p></aside>}
    </article>
    <footer class="reading-footer"><a href="/#caderno">Voltar ao Caderno</a><a href="/#contato">Conversar sobre um projeto</a></footer>
  </main>
</BaseLayout>
